# =============================================================================
# MultiHead Configuration
# =============================================================================
# Copy to .env and uncomment/edit values as needed.
# All values have sensible defaults -- an empty .env file works fine.
#
# Quick start:
#   cp .env.example .env
#   multihead init --auto
#   multihead serve

# --- Data Directory ---
# Where runs, artifacts, knowledge DB, and logs are stored.
# Default: ~/.multihead
# MULTIHEAD_DATA_DIR=~/.multihead

# --- Core Head ---
# Primary head for chat and agentic tasks. Must match a head_id in config/heads.yaml.
# Options: mock-llm (default), core-llm (local GPU), claude-sonnet (Claude CLI)
# MULTIHEAD_CORE_HEAD_ID=mock-llm

# --- API Server ---
# MULTIHEAD_API_HOST=127.0.0.1
# MULTIHEAD_API_PORT=7337

# --- Mesh Security (optional) ---
# Shared secret for mesh peer authentication. At least 16 characters.
# MULTIHEAD_MESH_SECRET=

# --- OpenAI API (optional) ---
# Only needed if you have an openai-type head in heads.yaml.
# OPENAI_API_KEY=sk-...

# =============================================================================
# BotVibes / ACP Integration (OPTIONAL)
# =============================================================================
# Only needed if you want multi-agent coordination via BotVibes marketplace.
# MultiHead works fully without ACP -- it just won't have marketplace features.
#
# Local ACP server:
# ACP_URL=http://localhost:8000/api/v1
#
# Cloud BotVibes marketplace (https://botvibes.io):
# ACP_URL=https://botvibes.io/api/v1
#
# ACP_TENANT_ID=
# ACP_PROJECT_ID=
# ACP_AGENT_ID=my-agent
# ACP_API_KEY=
#
# Claude worker daemon (optional — for delegating tasks to Claude sessions):
# ACP_CLAUDE_AGENT_ID=claude-session-agent
# ACP_CLAUDE_SESSION_KEY=

# =============================================================================
# BotVibes Cloud Marketplace (OPTIONAL)
# =============================================================================
# For marketplace trading (RFQs, bidding, contracts, escrow).
# Register at https://botvibes.io to get credentials.
#
# ACP_CLOUD_URL=https://botvibes.io/api/v1
# ACP_CLOUD_AGENT_ID=
# ACP_CLOUD_PROJECT_ID=
# ACP_CLOUD_API_KEY=
# ACP_CLOUD_TENANT_ID=
# ACP_CLOUD_EMAIL=
# ACP_CLOUD_PASSWORD=
